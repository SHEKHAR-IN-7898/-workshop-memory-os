generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  }

// Tenant is the security boundary. All business-owned records carry tenantId.
model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  memberships Membership[]
  customers   Customer[]
  vehicles    Vehicle[]
  technicians Technician[]
  parts       Part[]
  services    ServiceRecord[]
  invoices    Invoice[]
  documents   MemoryDocument[]

  @@index([status])
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  email       String       @unique
  displayName String?
  passwordHash String
  status      UserStatus   @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  memberships Membership[]
  auditEvents AuditEvent[]
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  userId    String         @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@index([tenantId, status])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]
  invoices Invoice[]

  @@unique([tenantId, id])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, name])
}

model Vehicle {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  customerId   String   @db.Uuid
  registration String
  vin          String?
  make         String?
  model        String?
  variant      String?
  modelYear    Int?
  fuelType     FuelType?
  odometerKm   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  services ServiceRecord[]
  invoices Invoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, registration])
  @@index([tenantId, customerId])
  @@index([tenantId, vin])
}

model Technician {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  phone     String?
  employeeCode String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services ServiceRecord[]

  @@unique([tenantId, id])
  @@unique([tenantId, employeeCode])
  @@index([tenantId, active])
}

model ServiceRecord {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  vehicleId      String        @db.Uuid
  technicianId   String?       @db.Uuid
  serviceDate    DateTime
  odometerKm     Int?
  complaint      String?
  diagnosis      String?
  workPerformed  String?
  status         ServiceStatus @default(COMPLETED)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle    Vehicle     @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict)
  technician Technician? @relation(fields: [tenantId, technicianId], references: [tenantId, id], onDelete: SetNull)
  invoice    Invoice?

  @@unique([tenantId, id])
  @@index([tenantId, vehicleId, serviceDate])
  @@index([tenantId, technicianId, serviceDate])
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  invoiceNumber  String
  customerId     String        @db.Uuid
  vehicleId      String        @db.Uuid
  serviceRecordId String?      @db.Uuid
  issueDate      DateTime
  dueDate        DateTime?
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  cgst           Decimal       @default(0) @db.Decimal(12, 2)
  sgst           Decimal       @default(0) @db.Decimal(12, 2)
  igst           Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue     Decimal       @default(0) @db.Decimal(12, 2)
  version        Int           @default(1)
  finalizedAt    DateTime?
  voidedAt       DateTime?
  voidReason     String?
  paymentMethod  PaymentMethod?
  status         InvoiceStatus @default(ISSUED)
  sourceDocumentId String?     @db.Uuid
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  vehicle       Vehicle        @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict)
  serviceRecord ServiceRecord? @relation(fields: [tenantId, serviceRecordId], references: [tenantId, id], onDelete: SetNull)
  lineItems     InvoiceLineItem[]
  sourceDocument MemoryDocument? @relation(fields: [tenantId, sourceDocumentId], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, customerId, issueDate])
  @@index([tenantId, vehicleId, issueDate])
  @@index([tenantId, status, dueDate])
}

model InvoiceLineItem {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  invoiceId   String     @db.Uuid
  lineNumber  Int
  itemType    LineItemType
  description String
  partNumber  String?
  partId      String?    @db.Uuid
  quantity    Decimal    @db.Decimal(12, 3)
  unitPrice   Decimal    @db.Decimal(12, 2)
  taxRate     Decimal    @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal    @db.Decimal(12, 2)
  metadata    Json?
  createdAt   DateTime   @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Cascade)
  part    Part?    @relation(fields: [tenantId, partId], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceId, lineNumber])
  @@index([tenantId, invoiceId])
  @@index([tenantId, partNumber])
  @@index([tenantId, partId])
}

model Part {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  partNumber  String
  name        String
  description String?
  unitPrice   Decimal? @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineItems  InvoiceLineItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, partNumber])
  @@index([tenantId, active])
}

model MemoryDocument {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  documentType   DocumentType
  storageKey     String
  originalName   String
  mimeType       String
  sha256         String
  sizeBytes      BigInt
  extractionStatus ExtractionStatus @default(PENDING)
  extractedText  String?
  extractedData  Json?
  sourceCreatedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, sha256])
  @@index([tenantId, documentType, createdAt])
  @@index([tenantId, extractionStatus])
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  TECHNICIAN
  STAFF
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
  LPG
  OTHER
}

enum ServiceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

enum LineItemType {
  PART
  LABOR
  SERVICE
  DISCOUNT
  OTHER
}

enum DocumentType {
  INVOICE
  SERVICE_REPORT
  CUSTOMER_NOTE
  CHAT_EXPORT
  OTHER
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  requestId   String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
}
